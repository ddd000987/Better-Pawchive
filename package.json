{
  "name": "better-pawchive",
  "version": "1.2.0",
  "description": "Batch downloader for Kemono / Pawchive creator posts. Derived from PixivBatchDownloader and Kemono-Downloader.",
  "author": "Better Pawchive contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd000987/Better-Pawchive.git"
  },
  "homepage": "https://github.com/ddd000987/Better-Pawchive#readme",
  "bugs": {
    "url": "https://github.com/ddd000987/Better-Pawchive/issues"
  },
  "scripts": {
    "locales": "node ./scripts/gen-locales.js",
    "prets": "npm run locales",
    "ts": "webpack --config ./webpack.conf.js",
    "prets:prod": "npm run locales",
    "ts:prod": "webpack --config ./webpack.conf.js --mode production",
    "less": "lessc ./src/style/style.less ./dist/style/style.css",
    "pack": "node ./scripts/pack.js",
    "make-icons": "node ./scripts/make-icons.js",
    "build": "npm run ts:prod && npm run less && npm run pack",
    "build:dev": "npm run ts && npm run less && npm run pack",
    "pretest": "npm run locales",
    "test": "vitest run",
    "pretypecheck": "npm run locales",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "check": "node ./scripts/gen-locales.js --check && npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "less": "^4.9.1",
    "prettier": "^3.10.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
